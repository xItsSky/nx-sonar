{
  "name": "nx-sonar-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "nx-sonar-e2e/src",
  "implicitDependencies": ["nx-sonar"],
  "targets": {
    "e2e": {
      "dependsOn": ["^build"],
      "options": {
        "passWithNoTests": true,
        "runInBand": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p nx-sonar-e2e/tsconfig.spec.json"
      }
    }
  }
}
